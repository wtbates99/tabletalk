   ordered_quantity,
   available_inventory,
   work_in_progress,
diff -ruN a/models/schema.yml b/models/schema.yml
--- a/models/schema.yml
+++ b/models/schema.yml
@@ -63,7 +63,7 @@
       - name: booked_revenue
         description: Contracted order value in USD before recognition.
         data_type: decimal(18,2)
