# A teammate's dbt PR: rename a revenue column and add a customer model to group:finance.
diff -ruN a/models/marts/dim_customers.sql b/models/marts/dim_customers.sql
--- a/models/marts/dim_customers.sql
+++ b/models/marts/dim_customers.sql
@@ -0,0 +1,4 @@
+select distinct
+  customer_id,
+  lower(customer_id) || '@example.com' as email
+from {{ ref('stg_orders') }}
diff -ruN a/models/marts/fct_orders.sql b/models/marts/fct_orders.sql
